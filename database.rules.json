{
  "rules": {
    ".read": true,
    ".write": true,
    "live_chats": {
      "$chatId": {
        ".indexOn": ["timestamp"]
      }
    },
    "calls": {
      "$callId": {
        "signals": {
          ".indexOn": ["timestamp"]
        }
      }
    },
    "typing": {
      "$chatId": {
        ".indexOn": [".value"]
      }
    }
  }
}
