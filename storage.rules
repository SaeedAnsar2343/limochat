rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // LimoChat Storage Security Rules
    // Supports avatars, voice notes, photos, videos, support files and attachments
    match /avatars/{allPaths=**} {
      allow read, write: if true;
    }
    match /chat_media/{allPaths=**} {
      allow read, write: if true;
    }
    match /status_media/{allPaths=**} {
      allow read, write: if true;
    }
    match /voice_notes/{allPaths=**} {
      allow read, write: if true;
    }
    match /support_media/{allPaths=**} {
      allow read, write: if true;
    }
    match /documents/{allPaths=**} {
      allow read, write: if true;
    }
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
