rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // LimoChat High-Availability Security & Moderation Rules
    // Optimized for WhatsApp-grade messaging, WebRTC calling, status stories,
    // Support desk, lifetime virtual numbers, automated policy enforcement & administrative sanctions

    // 1. User Profiles, Presence & Sanctions
    match /users/{userId} {
      allow read, write: if true;
      allow delete: if userId != 'limochat_official_support';
      
      // Violations & session subcollections
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 2. Direct, Group, Community & Support Chats
    match /chats/{chatId} {
      allow read, create, update: if true;
      allow delete: if !chatId.matches('support_.*');

      // Messages, attachments & signaling subcollections
      match /messages/{messageId} {
        allow read, write: if true;
      }
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 3. WebRTC Calling Sessions & ICE Signaling
    match /calls/{callId} {
      allow read, write: if true;

      match /callerCandidates/{candidateId} {
        allow read, write: if true;
      }
      match /calleeCandidates/{candidateId} {
        allow read, write: if true;
      }
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 4. 24-Hour Status Stories & Reactions
    match /statuses/{statusId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 5. Communities & Channels
    match /communities/{communityId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 6. System Configuration (Policy rules, moderation settings, app version, admin list)
    match /system_config/{configId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 7. Safety, Compliance Policies & Audits
    match /system_policies/{policyId} {
      allow read, write: if true;
    }
    match /violation_logs/{logId} {
      allow read, write: if true;
    }
    match /policy_incidents/{incidentId} {
      allow read, write: if true;
    }
    match /message_reports/{reportId} {
      allow read, write: if true;
    }

    // 8. Support Tickets & Admin Operations
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }
    match /admin_audit_logs/{logId} {
      allow read, write: if true;
    }
    match /app_version_config/{configId} {
      allow read, write: if true;
    }
    match /broadcasts/{broadcastId} {
      allow read, write: if true;
    }
    match /user_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /call_logs/{logId} {
      allow read, write: if true;
    }

    // 9. Comprehensive Catch-All Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
